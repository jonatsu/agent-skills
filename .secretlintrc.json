{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-no-homedir"
    },
    {
      "id": "@secretlint/secretlint-rule-no-dotenv"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "email address",
            "patterns": [
              "/[\\w.+-]+@(?!users\\.noreply\\.github\\.com\\b|(?:[\\w-]+\\.)*example\\.(?:com|net|org)\\b|(?:[\\w-]+\\.)*(?:example|test|invalid|localhost)\\b)(?:[\\w-]+\\.)+[A-Za-z]{2,}\\b/"
            ]
          }
        ]
      }
    }
  ]
}
